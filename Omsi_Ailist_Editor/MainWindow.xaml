<Window x:Class="Omsi_Ailist_Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Omsi_Ailist_Editor"
        mc:Ignorable="d"
        Title="Omsi2 Ailist Editor"
        Height="485" Width="843"
        MinWidth="400" MinHeight="300"
        MaxWidth="1200" MaxHeight="700"
        Background="#23272F"
        Foreground="White"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SizeToContent="Manual">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3A6EA5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#222" BlurRadius="8" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="4"
                                              SnapsToDevicePixels="True"
                                              UseLayoutRounding="True"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#2C313A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <ScrollViewer Margin="0" Focusable="False">
                                <ItemsPresenter SnapsToDevicePixels="True"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="8,8,8,0"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Load Ailist Button -->
            <Button x:Name="Load_Ailist_Button" 
                    Content="Load Ailist" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Height="68" 
                    Width="202" 
                    FontSize="20" 
                    HorizontalContentAlignment="Center" 
                    VerticalContentAlignment="Center" 
                    Padding="0" 
                    Click="Load_Ailist_Button_Click" 
                    d:IsHidden="True"/>

            <!-- Depot List -->
            <ListBox x:Name="Depots_List" 
                     MouseDoubleClick="Depots_List_Click" 
                     d:ItemsSource="{d:SampleData ItemCount=5}" 
                     Margin="10,42,0,115" 
                     HorizontalAlignment="Left"
                     Width="190"
                     Visibility="Visible"/>

            <!-- Depot Select Text -->
            <TextBlock x:Name="Depot_Select_Text" 
                       TextWrapping="Wrap" 
                       Text="Select Depot (Double click)." 
                       Margin="10,10,0,0" 
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Top"/>

            <!-- Bus Info Grid -->
            <Grid Margin="210,42,10,115">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Bus Info List -->
                <ListBox x:Name="Depot_Bus_Info" 
                         Grid.Row="0"
                         MouseDoubleClick="Bus_List_Click"
                         Visibility="Hidden"/>

                <!-- Change Bus Button -->
                <Button Name="Change_Bus_Button"
                        Content="Change bus"
                        Margin="0,6,0,56"
                        Visibility="Visible"
                        RenderTransformOrigin="0.5,0.5"
                        Grid.Row="1"
                        Click="Change_Bus_Button_Click">
                    <Button.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform Angle="-0.019"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Button.RenderTransform>
                </Button>

                <!-- Change Fleet Number Button -->
                <Button Name="Add_New_Bus_Button"
                        Grid.Row="1"
                        Content="Add new bus type"
                        Margin="0,61,0,0"
                        Visibility="Visible"
                        Click="add_new_bus_type_click"/>

                <!-- Change Registration Button -->
                <Button Name="Change_Registration_Button"
                        Grid.Row="1"
                        Content="Change Registration"
                        Margin="125,148,239,-76"
                        Visibility="Visible"
                        d:IsHidden="True"/>

                <!-- Change Repaint Button -->
                <Button Name="Change_Repaint_Button"
                        Grid.Row="1"
                        Content="Change Repaint"
                        Margin="412,148,0,-76"
                        Visibility="Visible"
                        d:IsHidden="True"/>
            </Grid>

            <!-- Watermark -->
            <TextBlock x:Name="Watermark" 
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Bottom" 
                       Margin="10,0,0,10"
                       FontSize="12"
                       Opacity="0.7">
                <Run Language="en-gb" Text="Made by Wagwanfortesco"/>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
